mistakes = {
    "teh": "the",
    "recieve": "receive",
    "definately": "definitely",
    "seperate": "separate"
}
text = input("Enter your sentence: ")
words = text.split()
found = False
for word in words:
    correct_word = word.lower().strip(".,!?")
    if correct_word in mistakes:
        print(word, "should be", mistakes[correct_word])
        found = True
for i in range(len(words) - 1):
    if words[i].lower().strip(".,!?") == words[i + 1].lower().strip(".,!?"):
        print("Repeated word found:", words[i])
        found = True
if found == False:
    print("No mistakes found!")
